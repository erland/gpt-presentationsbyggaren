{
  "input": {
    "presentation_plan": "tests/presentation-plan-example.md",
    "storyboard": "tests/storyboard-example.json",
    "source_material": [],
    "existing_presentation": null
  },
  "output": {
    "generation_mode": "visual-first",
    "primary_artifact": "pptx",
    "editable": false,
    "support_artifacts": ["presentation-plan", "pdf", "preview-images", "pptx-validation-report"]
  },
  "rendering": {
    "design_priority": "communication_quality",
    "text_strategy": "compose_after_image_generation",
    "allow_full_slide_rasterization": true,
    "slide_render_modes": ["image-slide", "hybrid-slide"],
    "companion_formats": ["pdf"],
    "image_generation": {
      "anchor_slides_first": true,
      "anchor_count": 2,
      "max_batch_size": 4,
      "whole_deck_single_prompt": false,
      "exact_copy_in_generated_images": false
    }
  },
  "sources": {
    "traceability": true,
    "current_claims_verified_when_possible": true,
    "unverified_claims_marked": true
  },
  "technical_validation": {
    "plan_validated": true,
    "package_integrity_checked": true,
    "relationships_checked": true,
    "independent_render_check": "pass",
    "preview_reviewed": true,
    "limitations": []
  },
  "quality": {
    "presentation_plan_gate_passed": true,
    "visuals_have_purpose": true,
    "layout_overflow_checked": true,
    "technical_gate_passed": true,
    "visual_ambition_checked": true,
    "anchor_style_approved": true
  }
}
